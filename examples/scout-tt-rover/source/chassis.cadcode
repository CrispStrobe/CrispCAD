  move([-45,-41,2],box(13,4,12)),
  move([-45,41,2],box(13,4,12)),
  move([-10,0,2],cylinder(1.7,12,32)),
  move([10,0,2],cylinder(1.7,12,32)),
  move([30,0,2],cylinder(1.7,12,32)),
  move([50,0,2],cylinder(1.7,12,32)));
