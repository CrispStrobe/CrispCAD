  move([-25.3,51,2],cylinder(1.7,12,32)),
  move([37.7,37,2],cylinder(1.7,12,32)),
  move([37.7,51,2],cylinder(1.7,12,32)),
  move([-20,-22,2],cylinder(1.7,12,32)),
  move([-20,22,2],cylinder(1.7,12,32)),
  move([40,-22,2],cylinder(1.7,12,32)),
  move([40,22,2],cylinder(1.7,12,32)),
  move([-96,0,2],cylinder(1.7,12,32)),
  move([-74,0,2],cylinder(1.7,12,32)),
  move([-85,-41,2],box(13,4,12)),
