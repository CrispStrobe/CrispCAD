nce/2],cylinder(boardBore/2,8 mm+boardClearance,16)),\n  move([8.89,22.86,3 mm+boardClearance/2],cylinder(boardBore/2,8 mm+boardClearance,16)),\n  move([21.84,6.35,3 mm+boardClearance/2],cylinder(boardBore/2,8 mm+boardClearance,16)),\n  move([42.16,6.35,3 mm+boardClearance/2],cylinder(boardBore/2,8 mm+boardClearance,16)));\nlet undersideHeads=union(move([-8.89,-22.86,0.7],frustum(2.8,1.4,1.4,16)),\n  move([8.89,-22.86,0.7],frustum(2.8,1.4,1.4,16)),\n  move([-8.89,22.86,0.7],frustum(2.8,1.4,1.4,16)),\n  move([8.89,22.86,0.7],frustum(2.8,1.4,1.4,16)),\n  move([21.84,6.35,0.7],frustum(2.8,1.4,1.4,16)),\n  move([42.16,6.35,0.7],frustum(2.8,1.4,1.4,16)));\nlet deckBores=union(move([25,-12.5,2],cylinder(1.7,10,16)),\n  move([25,12.5,2],cylinder(1.7,10,16)),\n  move([39,-12.5,2],cylinder(1.7,10,16)),\n  move([39,12.5,2],cylinder(1.7,10,16)));\nlet deckHeads=union(move([25,-12.5,2.2],frustum(1.7,3.3,1.6,16)),\n  move([25,12.5,2.2],frustum(1.7,3.3,1.6,16)),\n  move([39,-12.5,2.2],frustum(1.7,3.3,1.6,16)),\n  move([39,12.5,2.2],frustum(1.7,3.3,1.6,16)));\nreturn choose(boardClearance >= 6 mm && boardClearance <= 20 mm && boardBore >= 2.6 mm && boardBore <= 3 mm,\n subtract(union(plate,bosses),boardBores,undersideHeads,deckBores,deckHeads),empty());\n"},"transform":{"position":[0,0,49],"rotation":[0,0,0],"scale":[1,1,1]},"color":"#80c7be","physics":{"version":1,"motion":"dynamic","densityKgM3":1240,"friction":0.4,"restitution":0.02,"intent":"rigid","material":"plastic","sourcePreset":"robot-tt-rover","collisionAssembly":[{"positions":[40.47224426269531,-13.350000381469727,0,40.70000076293945,-12.500000953674316,0,40.47224426269531,-13.350000381469727,1.399999976158142,40.70000076293945,-12.5,1.399999976158142,41.7486457824707,-14.259236335754395,3,42.29999923706055,-12.5,3,47,-18,0,47,-18,3,47,-12.500004768371582,0,47,-12.50000286102295,3],"indices":[1,0,2,0,4,2,1,2,3,5,1,3,0,6,4,8,0,1,5,8,1,2,4,3,4,5,3,9,5,4,4,6,7,6,9,7,6,0,8,9,6,8,9,4,7,9,8,5]},{"positions":[40.7000007629394