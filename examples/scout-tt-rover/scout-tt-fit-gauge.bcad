{"format":"brickwright-cad","version":8,"units":"mm","id":"scout-tt-fit","title":"Double-D shaft fit gauge","nodes":{"fit":{"id":"fit","name":"Double-D shaft fit gauge","kind":"code","program":{"version":1,"language":"brickwright-cad-script","parameters":{},"source":"// Original Scout TT rover part; BSD-3-Clause. Millimetres.\nlet plate=move([0,0,2],box(74,18,4));\nreturn subtract(plate,\n move([-28,0,2],intersect(cylinder(2.7750000000000004,8,48),box(10,3.85,8))),\n  move([-14,0,2],intersect(cylinder(2.825,8,48),box(10,3.95,8))),\n  move([0,0,2],intersect(cylinder(2.875,8,48),box(10,4.05,8))),\n  move([14,0,2],intersect(cylinder(2.9250000000000003,8,48),box(10,4.15,8))),\n  move([28,0,2],intersect(cylinder(2.975,8,48),box(10,4.25,8))),\n move([-28,7.5,2],cylinder(0.55,8,16)),\n  move([-15,7.5,2],cylinder(0.55,8,16)),\n  move([-13,7.5,2],cylinder(0.55,8,16)),\n  move([-2,7.5,2],cylinder(0.55,8,16)),\n  move([0,7.5,2],cylinder(0.55,8,16)),\n  move([2,7.5,2],cylinder(0.55,8,16)),\n  move([11,7.5,2],cylinder(0.55,8,16)),\n  move([13,7.5,2],cylinder(0.55,8,16)),\n  move([15,7.5,2],cylinder(0.55,8,16)),\n  move([17,7.5,2],cylinder(0.55,8,16)),\n  move([24,7.5,2],cylinder(0.55,8,16)),\n  move([26,7.5,2],cylinder(0.55,8,16)),\n  move([28,7.5,2],cylinder(0.55,8,16)),\n  move([30,7.5,2],cylinder(0.55,8,16)),\n  move([32,7.5,2],cylinder(0.55,8,16)));\n"},"transform":{"position":[0,0,0],"rotation":[0,0,0],"scale":[1,1,1]},"color":"#e8ab47","physics":{"version":1,"motion":"dynamic","densityKgM3":1240,"friction":0.4,"restitution":0.02,"intent":"rigid","material":"plastic","sourcePreset":"robot-tt-rover"}}},"roots":["fit"]}
