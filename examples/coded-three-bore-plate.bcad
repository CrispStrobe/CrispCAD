{"format":"brickwright-cad-history","version":1,"project":{"id":"db67b935-e9de-42fd-a797-6af242bdf692","title":"Coded three-bore plate","headId":"62308e5b-8aff-4440-93de-9c9a264bd896","serial":1,"updatedAt":1794549276915},"revisions":[{"id":"62308e5b-8aff-4440-93de-9c9a264bd896","projectId":"db67b935-e9de-42fd-a797-6af242bdf692","parentId":null,"serial":1,"createdAt":1794549276915,"label":"Created coded plate","header":{"format":"brickwright-cad","version":4,"units":"mm","id":"db67b935-e9de-42fd-a797-6af242bdf692","title":"Coded three-bore plate","roots":["a54db5e0-5839-4ccc-95b2-885f05c94050"]},"nodeRefs":{"a54db5e0-5839-4ccc-95b2-885f05c94050":"e2dacfba2fc0588ca22aef1d32f8fedcf8342da19c42e8f475c06081c8b2e86c"},"snapshotHash":"6126027ae61f520f54fb688f3dd33c337152134956ec622a82547c2f1de4fbf1"}],"objects":[{"hash":"e2dacfba2fc0588ca22aef1d32f8fedcf8342da19c42e8f475c06081c8b2e86c","kind":"node","value":"{\"id\":\"a54db5e0-5839-4ccc-95b2-885f05c94050\",\"kind\":\"code\",\"program\":{\"version\":1,\"language\":\"brickwright-cad-script\",\"parameters\":{},\"source\":\"// A dimensioned plate with three bores. Coordinates are millimetres.\\nparam width: mm = 60;\\nparam depth: mm = 30;\\nparam thickness: mm = 5;\\nparam bore: mm = 3;\\nlet plate = move([0, 0, thickness / 2], box(width, depth, thickness));\\nlet holes = move([-20, 0, thickness / 2], repeat(3, [20, 0, 0], cylinder(bore, thickness * 2)));\\nreturn subtract(plate, holes);\\n\"},\"name\":\"Three-bore plate\",\"color\":\"#76b7ce\",\"transform\":{\"position\":[0,0,0],\"rotation\":[0,0,0],\"scale\":[1,1,1]}}"}]}