{
  "name": "brickwright-cad-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run build:packages && npm run assets && vite --host 127.0.0.1",
    "assets": "node scripts/copy-assets.mjs",
    "build:packages": "tsc -b",
    "build": "npm run build:packages && tsc -p apps/standalone/tsconfig.json && npm run assets && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run check:i18n && npm test && npm run test:e2e",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify:brickwright": "node scripts/verify-brickwright.mjs",
    "ipad:sync": "npm run build && cap sync ios",
    "ipad:open": "cap open ios",
    "ipad:archive": "npm run ipad:sync && node scripts/archive-ipad.mjs",
    "ipad:install": "node scripts/install-ipad.mjs",
    "verify:physics": "node scripts/qualify-catalog-physics.mjs",
    "mac:build": "npm run build && node scripts/build-macos.mjs",
    "mac:run": "npm run mac:install",
    "mac:verify": "\"apps/macos/build/Brickwright CAD.app/Contents/MacOS/BrickwrightCAD\" --smoke-test",
    "mac:install": "node scripts/install-macos.mjs",
    "mcp": "node apps/mcp/server.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "library:examples:generate": "npm run build:packages && node scripts/generate-example-library.mjs --write",
    "library:examples:check": "npm run build:packages && node scripts/generate-example-library.mjs --check"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.15.18",
    "@types/three": "^0.184.1",
    "fake-indexeddb": "6.2.8",
    "fflate": "0.8.3",
    "typescript": "^5.8.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3"
  }
}
